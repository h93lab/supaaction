# Copy this file to .env before running Docker Compose.
# SESSION_SECRET and ENCRYPTION_KEY must be at least 32 characters in production.
APP_PASSWORD=change-this-admin-password
SESSION_SECRET=replace-with-a-long-random-value
ENCRYPTION_KEY=replace-with-another-long-random-value
APP_URL=http://localhost:3000
DATABASE_PATH=/data/supaaction.db
SESSION_TTL_HOURS=24
SCHEDULER_ENABLED=true
